@inject CurrentUser Current
@inject PopService Pops
@inject AccountService Accounts
@{
    var user = Current.Required;
    var waiting = user.IsAdmin ? await Pops.WaitingCountAsync() : 0;
    var pending = user.IsAdmin ? await Accounts.PendingCountAsync() : 0;
    var section = ViewData["Nav"] as string;
    string? Current_(string name) => section == name ? "page" : null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Base de conhecimento da CSTIC do HC Recife.">
    <title>@ViewData["Title"] · CSTIC</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    @await RenderSectionAsync("Head", required: false)
</head>
<body data-mode="@ViewData["Mode"]">
<a class="skip-link" href="#conteudo-principal">Ir para o conteúdo</a>
<aside class="sidebar" aria-label="Navegação">
    <a class="brand" href="/" aria-label="CSTIC, página inicial">
        <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 3h6v6h6v6h-6v6H9v-6H3V9h6z"/></svg></span>
        <span><strong>CSTIC</strong><small>HC RECIFE</small></span>
    </a>
    <div class="workspace-label">CONHECIMENTO QUE RESOLVE</div>
    <nav class="app-nav" aria-label="Principal">
        <a href="/pops" aria-current="@Current_("pops")">Meus POPs</a>
        <a href="/pops/novo" aria-current="@Current_("novo")">Criar POP</a>
        <a href="/pops/importar" aria-current="@Current_("importar")">Importar Word</a>
        @if (user.IsAdmin)
        {
            <span class="nav-label">ADMINISTRAÇÃO</span>
            <a href="/admin/pops" aria-current="@Current_("recebidos")">POPs recebidos @if (waiting > 0) {<span class="nav-badge" aria-label="@waiting aguardando">@waiting</span>}</a>
            <a href="/admin/usuarios" aria-current="@Current_("usuarios")">Usuários @if (pending > 0) {<span class="nav-badge" aria-label="@pending cadastros pendentes">@pending</span>}</a>
        }
    </nav>
    @await RenderSectionAsync("Sidebar", required: false)
    <div class="sidebar-user">
        <strong>@user.FullName</strong>
        <small>@user.Function · @user.RoleLabel</small>
        <div class="sidebar-user-actions">
            <a href="/conta/senha">Alterar senha</a>
            <form method="post" asp-page="/Sair"><button type="submit">Sair</button></form>
        </div>
    </div>
</aside>

<div class="workspace">
    <header class="topbar"><span>Base de conhecimento <span class="breadcrumb-divider">/</span> <strong>@ViewData["Title"]</strong></span><span class="topbar-tag">@(user.IsAdmin ? "ADMINISTRADOR" : "TÉCNICO")</span></header>
    <main class="main-content" id="conteudo-principal" tabindex="-1">
        @if (TempData["Notice"] is string notice)
        {
            <div class="notice" role="status">@notice</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="notice error" role="alert">@error</div>
        }
        @RenderBody()
        <footer class="page-footer"><span>CSTIC · Hospital das Clínicas · Recife</span><span>Base de conhecimento da equipe</span></footer>
    </main>
</div>
@await RenderSectionAsync("Templates", required: false)
</body>
</html>
